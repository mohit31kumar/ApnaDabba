generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model addon_catalog {
  id                String              @id @default(uuid())
  name              String              @db.VarChar(100)
  price             Decimal             @db.Decimal(10, 2)
  is_available      Boolean             @default(true)
  created_at        DateTime?           @default(now()) @db.DateTime(3)
  addon_order_items addon_order_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model addon_order_items {
  id               String        @id @default(uuid())
  addon_order_id   String
  addon_catalog_id String
  quantity         Int
  unit_price       Decimal       @db.Decimal(10, 2)
  created_at       DateTime?     @default(now()) @db.DateTime(3)
  addon_catalog    addon_catalog @relation(fields: [addon_catalog_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addon_orders     addon_orders  @relation(fields: [addon_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model addon_orders {
  id                String              @id @default(uuid())
  delivery_id       String
  total_amount      Decimal             @db.Decimal(10, 2)
  payment_mode      String              @db.VarChar(20)
  payment_status    String              @db.VarChar(20)
  created_at        DateTime?           @default(now()) @db.DateTime(3)
  addon_order_items addon_order_items[]
  deliveries        deliveries          @relation(fields: [delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admin_alerts {
  id              String         @id @default(uuid())
  alert_type      String         @db.VarChar(50)
  subscription_id String?
  message         String
  is_resolved     Boolean        @default(false)
  resolved_by     String?
  created_at      DateTime?      @default(now()) @db.DateTime(3)
  resolved_at     DateTime?      @db.DateTime(3)
  users           users?         @relation(fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions   subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model assistant_preferences {
  id               String    @id @default(uuid())
  user_id          String    @unique
  preferences_json Json      @default("{}")
  updated_at       DateTime? @default(now()) @db.DateTime(3)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_logs {
  id             String    @id @default(uuid())
  entity_name    String    @db.VarChar(100)
  entity_id      String
  action         String    @db.VarChar(50)
  previous_state Json?
  new_state      Json
  performed_by   String?
  ip_address     String?   @db.VarChar(45)
  created_at     DateTime? @default(now()) @db.DateTime(3)
  users          users?    @relation(fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deliveries {
  id                 String              @id @default(uuid())
  subscription_id    String
  tiffin_box_id      String?
  delivery_date      DateTime            @db.Date
  slot               String              @db.VarChar(20)
  status             String              @db.VarChar(50)
  cutoff_time        DateTime            @db.DateTime(3)
  delivered_at       DateTime?           @db.DateTime(3)
  location_locked    Boolean             @default(false)
  location_locked_at DateTime?           @db.DateTime(3)
  is_buffer_meal     Boolean             @default(false)
  buffer_expiry_at   DateTime?           @db.DateTime(3)
  is_special_meal    Boolean             @default(false)
  delivery_notes     String?
  created_at         DateTime?           @default(now()) @db.DateTime(3)
  updated_at         DateTime?           @default(now()) @db.DateTime(3)
  driver_id          String?
  addon_orders       addon_orders[]
  subscriptions      subscriptions       @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tiffin_boxes       tiffin_boxes?       @relation(fields: [tiffin_box_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guest_meal_orders  guest_meal_orders[]
  route_logs         route_logs[]
  tiffin_events      tiffin_events[]

  @@unique([subscription_id, delivery_date, slot])
  @@index([delivery_date, status], map: "idx_deliveries_date_status")
  @@index([subscription_id], map: "idx_deliveries_subscription_id")
  @@index([subscription_id, delivery_date], map: "idx_delivery_subscription_date")
}

model delivery_addresses {
  id             String          @id @default(uuid())
  user_id        String
  address_line_1 String
  address_line_2 String?
  landmark       String?         @db.VarChar(255)
  city           String          @db.VarChar(100)
  pincode        String          @db.VarChar(20)
  lat            Decimal?        @db.Decimal(10, 8)
  lng            Decimal?        @db.Decimal(11, 8)
  is_active      Boolean         @default(true)
  created_at     DateTime?       @default(now()) @db.DateTime(3)
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions  subscriptions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guest_meal_orders {
  id             String     @id @default(uuid())
  delivery_id    String
  quantity       Int
  total_amount   Decimal    @db.Decimal(10, 2)
  payment_mode   String     @db.VarChar(20)
  payment_status String     @db.VarChar(20)
  created_at     DateTime?  @default(now()) @db.DateTime(3)
  deliveries     deliveries @relation(fields: [delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notification_logs {
  id         String    @id @default(uuid())
  user_id    String
  channel    String    @db.VarChar(20)
  title      String?   @db.VarChar(255)
  body       String
  status     String    @db.VarChar(20)
  created_at DateTime? @default(now()) @db.DateTime(3)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model otp_sessions {
  id         String    @id @default(uuid())
  phone      String    @db.VarChar(20)
  otp_hash   String    @db.VarChar(255)
  expires_at DateTime  @db.DateTime(3)
  is_used    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.DateTime(3)
}

model plan_configs {
  id               String          @id @default(uuid())
  plan_code        String          @unique @db.VarChar(50)
  name             String          @db.VarChar(100)
  description      String?
  price_per_meal   Decimal         @db.Decimal(10, 2)
  security_deposit Decimal         @db.Decimal(10, 2)
  skip_limit       Int
  buffer_days      Int
  is_active        Boolean         @default(true)
  created_at       DateTime?       @default(now()) @db.DateTime(3)
  subscriptions    subscriptions[]
}

model refresh_tokens {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.DateTime(3)
  revoked    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.DateTime(3)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model route_logs {
  id              String     @id @default(uuid())
  delivery_boy_id String
  delivery_id     String
  lat             Decimal    @db.Decimal(10, 8)
  lng             Decimal    @db.Decimal(11, 8)
  event           String     @db.VarChar(50)
  created_at      DateTime?  @default(now()) @db.DateTime(3)
  users           users      @relation(fields: [delivery_boy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries      deliveries @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscription_wallets {
  id                    String                @id @default(uuid())
  subscription_id       String                @unique
  balance               Decimal               @default(0.00) @db.Decimal(10, 2)
  security_deposit_held Decimal               @default(0.00) @db.Decimal(10, 2)
  updated_at            DateTime?             @default(now()) @db.DateTime(3)
  subscriptions         subscriptions         @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallet_transactions   wallet_transactions[]

  @@index([subscription_id], map: "idx_subscription_wallets_subscription_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscriptions {
  id                        String                @id @default(uuid())
  user_id                   String
  plan_config_id            String
  delivery_address_id       String
  status                    String                @db.VarChar(50)
  start_date                DateTime              @db.Date
  end_date                  DateTime              @db.Date
  skip_balance              Int                   @default(0)
  skipped_meal_pool         Int                   @default(0)
  buffer_start_date         DateTime?             @db.Date
  buffer_expiry_date        DateTime?             @db.Date
  buffer_meals_remaining    Int                   @default(0)
  price_per_meal_snapshot   Decimal               @db.Decimal(10, 2)
  total_price_snapshot      Decimal               @db.Decimal(10, 2)
  security_deposit_snapshot Decimal               @db.Decimal(10, 2)
  skip_limit_snapshot       Int
  buffer_days_snapshot      Int
  plan_code_snapshot        String                @db.VarChar(50)
  created_at                DateTime?             @default(now()) @db.DateTime(3)
  updated_at                DateTime?             @default(now()) @db.DateTime(3)
  admin_alerts              admin_alerts[]
  deliveries                deliveries[]
  subscription_wallets      subscription_wallets?
  delivery_addresses        delivery_addresses    @relation(fields: [delivery_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_configs              plan_configs          @relation(fields: [plan_config_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                     users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tiffin_tracker            tiffin_tracker?

  @@index([user_id, status], map: "idx_subscription_user_status")
  @@index([user_id], map: "idx_subscriptions_user")
}

model system_configs {
  config_key   String    @id @db.VarChar(100)
  config_value Json
  description  String?
  updated_at   DateTime? @default(now()) @db.DateTime(3)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tiffin_boxes {
  id            String          @id @default(uuid())
  qr_code       String          @unique @db.VarChar(100)
  status        String          @db.VarChar(50)
  created_at    DateTime?       @default(now()) @db.DateTime(3)
  deliveries    deliveries[]
  tiffin_events tiffin_events[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tiffin_events {
  id            String       @id @default(uuid())
  tiffin_box_id String
  delivery_id   String
  action        String       @db.VarChar(50)
  performed_by  String?
  created_at    DateTime?    @default(now()) @db.DateTime(3)
  deliveries    deliveries   @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users?       @relation(fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tiffin_boxes  tiffin_boxes @relation(fields: [tiffin_box_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tiffin_tracker {
  id                String        @id @default(uuid())
  subscription_id   String        @unique
  tiffins_due       Int           @default(0)
  security_deducted Boolean       @default(false)
  updated_at        DateTime?     @default(now()) @db.DateTime(3)
  subscriptions     subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([subscription_id], map: "idx_tiffin_tracker_subscription_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                    String                 @id @default(uuid())
  phone                 String                 @unique @db.VarChar(20)
  role                  String                 @default("CUSTOMER") @db.VarChar(20)
  first_name            String?                @db.VarChar(100)
  last_name             String?                @db.VarChar(100)
  is_active             Boolean                @default(true)
  created_at            DateTime?              @default(now()) @db.DateTime(3)
  updated_at            DateTime?              @default(now()) @db.DateTime(3)
  password_hash         String?
  is_temp_password      Boolean                @default(false)
  admin_alerts          admin_alerts[]
  assistant_preferences assistant_preferences?
  audit_logs            audit_logs[]
  delivery_addresses    delivery_addresses[]
  notification_logs     notification_logs[]
  refresh_tokens        refresh_tokens[]
  route_logs            route_logs[]
  subscriptions         subscriptions[]
  tiffin_events         tiffin_events[]

  @@index([phone], map: "idx_users_phone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model wallet_transactions {
  id                     String               @id @default(uuid())
  subscription_wallet_id String
  amount                 Decimal              @db.Decimal(10, 2)
  transaction_type       String               @db.VarChar(10)
  transaction_category   String               @db.VarChar(50)
  reference_id           String?
  description            String
  created_at             DateTime?            @default(now()) @db.DateTime(3)
  subscription_wallets   subscription_wallets @relation(fields: [subscription_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_wallet_id, created_at], map: "idx_wallet_transaction_created")
  @@index([subscription_wallet_id], map: "idx_wallet_transactions_wallet_id")
}
